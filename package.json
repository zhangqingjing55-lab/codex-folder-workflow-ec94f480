{
  "name": "codex-folder-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Editable portrait Remotion workflow with a little Codex helper sorting image cards into a folder.",
  "scripts": {
    "start": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "render:folder": "node scripts/render.mjs FolderSequence",
    "stills": "node scripts/render.mjs --stills-only"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3"
  }
}
